# Copy this file to config/openrouter.env. Never commit the real key.
# off: local only; auto: cloud escalation on weak evidence; always: cloud second opinion
OPENROUTER_MODE=off
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_COST_USD_PER_SONG=0.20
OPENROUTER_REQUEST_COST_GUARD_USD=0.10
OPENROUTER_VISION_QC_FRAME_COUNT=12
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_RETRY_ATTEMPTS=2
OPENROUTER_APP_NAME=MT Auto Music Karaoke Studio
